# =============================================================================
# KMFRI Scientists & Research Management System - Render Environment Variables
# =============================================================================
# Copy this to .env.local for local development, or enter values in Render Dashboard.
# NEVER commit actual secrets to git. .env* files are gitignored.
# =============================================================================

# ----- Required: Supabase Project Credentials (get from Supabase Dashboard → Settings → API) -----
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ----- Optional: Bootstrap Admin Password (≥12 chars; otherwise generated and logged) -----
# Set this to avoid the generated password in logs on first deploy.
KMFRI_INITIAL_ADMIN_PASSWORD=your-secure-password-123

# ----- Optional: Gemini API Key for AI Assistant -----
GEMINI_API_KEY=AIzaSy...

# ----- Render sets these automatically (do not override) -----
# NODE_ENV=production
# NODE_VERSION=22.18.0
# KMFRI_DATA_DIR=/data
# SESSION_SECRET=<auto-generated>
# KMFRI_ALLOW_ROLE_SWITCH=false
# SUPABASE_MIRROR_ENABLED=false

# ----- Local development only (not used on Render) -----
# SUPABASE_MIRROR_MODE=mirror
# SUPABASE_MIRROR_DEBOUNCE_MS=1500