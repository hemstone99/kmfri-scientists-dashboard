# =============================================================================
# KMFRI Scientists & Research Management System - environment template
# =============================================================================
# Copy to `.env` for local development. NEVER commit a real `.env`.
# Every value below is a placeholder - the application will start without most
# of them, but the corresponding feature stays disabled.
# =============================================================================

# --- Core server -------------------------------------------------------------
# Port the Express server listens on. Render sets this automatically.
PORT=3000

# Where the JSON data store and credential file live.
# On Render, point this at your mounted Persistent Disk (see render.yaml), e.g.
#   KMFRI_DATA_DIR=/data
# Left unset it defaults to ./data, which is EPHEMERAL on Render.
KMFRI_DATA_DIR=

# --- Required in production --------------------------------------------------
# HMAC key for session tokens. If unset, a random key is generated at boot and
# every restart invalidates all sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Password given to bootstrap/system admin accounts on first run.
# Must be at least 12 characters. If unset, a strong password is generated and
# printed once to the server log. No password is hardcoded in source.
KMFRI_INITIAL_ADMIN_PASSWORD=

# Sign-in session lifetime in hours (default 12).
SESSION_TTL_HOURS=12

# Enables the "Switch Active Session Role" RBAC verification menu.
# Off by default: the endpoint grants role sessions and must never be exposed
# publicly. Requires a signed-in SUPER_ADMIN even when enabled.
KMFRI_ALLOW_ROLE_SWITCH=false

# --- Google Gemini (AI Assistant) -------------------------------------------
# Without a key the Assistant features report that AI is unavailable.
GEMINI_API_KEY=

# --- Supabase / PostgreSQL mirror -------------------------------------------
# Point the mirror at the project that has supabase/migrations/0001_kmfri_schema.sql
# and supabase/seed.sql applied. See README "Supabase / PostgreSQL Mirror".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mirror the JSON snapshot into Postgres on every save. Keep false until the
# schema has been applied, otherwise every run reports column mismatches.
SUPABASE_MIRROR_ENABLED=false
# mirror = upsert only (non-destructive) | sync = upsert and delete rows absent from the snapshot
SUPABASE_MIRROR_MODE=mirror
SUPABASE_MIRROR_DEBOUNCE_MS=1500
# Optional comma-separated allowlist, e.g. "projects,reports,funding"
SUPABASE_MIRROR_TABLES=